---
import { Image } from "astro:assets";
import iconRight from "../assets/images/iconos/right-azul.png";
---
<nav class="w-full h-[80px] md:h-[92px] sticky top-0 z-50 shadow-lg">
    <div class="flex h-full">
        <div class="flex-[3] bg-[#00388B] flex items-center px-6 md:px-12">
            <a href="/" aria-label="Ir a la página de inicio de P&A Racks" class="group flex items-center gap-2">
                <span class="text-white text-2xl md:text-3xl font-extrabold tracking-tighter transition-transform group-hover:scale-105">
                    P&A <span class="text-blue-300">RACKS</span>
                </span>
            </a>
        </div>

        <div class="flex flex-[1] md:flex-[1.5] h-full">
            
            <a href={`${import.meta.env.BASE_URL}contactos`} 
                class="hidden md:flex flex-1 bg-[#FFA100] transition-colors justify-center items-center group"
                aria-label="Ir a la página de contactos">
                    <div class="flex items-center gap-2">
                        <span class="text-[#00388B] font-bold uppercase tracking-wider text-sm lg:text-base">Contáctanos</span>
                        <Image src={iconRight} alt="icono right" class="h-6 w-6" loading="lazy"/>
                    </div>
            </a>

            <button id="menuBtn" 
                class="flex-1 bg-[#EBEFF6] hover:bg-gray-200 transition-colors flex justify-center items-center gap-2 cursor-pointer border-none outline-none group">
                <span class="text-[#152F7E] text-sm md:text-lg font-black uppercase tracking-widest group-hover:text-blue-800">Menú</span>
                <div class="flex flex-col gap-1.5">
                    <span class="w-6 h-0.5 bg-[#152F7E] rounded-full group-hover:w-8 transition-all"></span>
                    <span class="w-8 h-0.5 bg-[#152F7E] rounded-full"></span>
                    <span class="w-6 h-0.5 bg-[#152F7E] rounded-full self-end group-hover:w-8 transition-all"></span>
                </div>
            </button>

        </div>
    </div>
</nav>