---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <main>
    <section
      class="relative h-[250px] md:h-[350px] lg:h-[600px] overflow-hidden"
    >
      <img
        src={`${import.meta.env.BASE_URL}images/banner/banner-inicio/img-2.jpeg`}
        alt=""
        class="w-full h-full object-cover"
      />

      <div class="absolute inset-0 bg-black/40"></div>

      <div class="absolute inset-0 flex items-end">
        <div
          class="max-w-[1200px] mx-auto px-6 pb-10 w-full flex flex-col md:flex-row justify-between gap-4 md:gap-0"
        >
          <div>
            <h1 class="text-3xl md:text-5xl font-bold text-white">Clientes</h1>
            <h2 class="text-xl md:text-2xl font-base text-white pt-2">
              En R&A Racks creemos firmemente que nuestro éxito es proporcional
              a la confianza que nuestros clientes depositan en nosotros.
            </h2>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-[1200px] mx-auto px-5 py-10">
      <p class="text-xl md:text-2xl font-base">
        A continuación, algunos de los clientes que han decidido confiar en
        nosotros como proveedor de soluciones de almacenaje y que nos han
        permitido crecer juntos.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 my-16">

        <!-- BOART LONGYEAR  -->
        <div class="group relative flex items-center justify-center p-6 hover:bg-gray-500 rounded-md">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/boart-longyear-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/boart-longyear-w.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- CERRO VERDER -->
        <div class="group relative flex items-center justify-center ">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/cerro-verde-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/cerro_verde.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- COREPTEC  -->
        <div class="group relative flex items-center justify-center p-6">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/coreptec-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/coreptec.svg`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- DANPER  -->
        <div class="group relative flex items-center justify-center p-6 hover:bg-red-800 rounded-md">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/danper-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/danper.svg`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- FRIOPACKING  -->
        <div class="group relative flex items-center justify-center p-6 hover:bg-gray-800 rounded-md">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/friopacking-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/friopacking.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- FRIOTEAM  -->
        <div class="group relative flex items-center justify-center p-6 hover:bg-sky-950 rounded-md">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/frioteam-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/frioteam.svg`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- SOLTRAK  -->
        <div class="group relative flex items-center justify-center p-6">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/logo_soltrak-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/logo_soltrak.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- OVERALL  -->
        <div class="group relative flex items-center justify-center p-6">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/overall_blue-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/overall_blue.svg`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- PURA FRUIT  -->
        <div class="group relative flex items-center justify-center p-6 hover:bg-gray-800 rounded-md">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/pura-fruit-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/pura-fruit.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- SAVAR -->
        <div class="group relative flex items-center justify-center p-6">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/savar-azul.jpg`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/savar.jpg`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- SERVIFABRICK -->
        <div class="group relative flex items-center justify-center p-6">
          <div class="relative h-14 w-[200px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/servifabrick-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/servifabrick.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>

        <!-- UNION -->
        <div class="group relative flex items-center justify-center p-2">
          <div class="relative h-14 w-[350px] flex items-center justify-center">
            <!-- Logo azul -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/union-azul.png`}
              class="absolute max-h-full max-w-full object-contain transition-opacity duration-500 group-hover:opacity-0"
            />

            <!-- Logo original -->
            <img
              src={`${import.meta.env.BASE_URL}images/img-clientes/union.png`}
              class="absolute max-h-full max-w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
