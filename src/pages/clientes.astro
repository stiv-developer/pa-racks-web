---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from 'astro:assets';
import bannerInicio from '../assets/images/banner/banner-inicio/img-2.jpeg';
import logoBoartLongyearAzul from '../assets/images/logos/boart-longyear-azul.png';
import logoBoartLongyearBlanco from '../assets/images/logos/boart-longyear-w.png';
import logoCerroVerdeAzul from '../assets/images/logos/cerro-verde-azul.png';
import logoCerroVerdeColor from '../assets/images/logos/cerro_verde.png';
import logoCoreptecAzul from '../assets/images/logos/coreptec-azul.png';
import logoCoreptecColor from '../assets/images/logos/coreptec.svg';
import logoDanperAzul from '../assets/images/logos/danper-azul.png';
import logoDanperColor from '../assets/images/logos/danper.svg';
import logoFriopackingAzul from '../assets/images/logos/friopacking-azul.png';
import logoFriopackingColor from '../assets/images/logos/friopacking.png';
import logoFrioteamAzul from '../assets/images/logos/frioteam-azul.png';
import logoFrioteamColor from '../assets/images/logos/frioteam.svg';
import logoSoltrackAzul from '../assets/images/logos/logo_soltrak-azul.png';
import logoSoltrackColor from '../assets/images/logos/logo_soltrak.png';
import logoOverallAzul from '../assets/images/logos/overall_blue-azul.png';
import logoOverallColor from '../assets/images/logos/overall_blue.svg';
import logoPuraFruitAzul from '../assets/images/logos/pura-fruit-azul.png';
import logoPuraFruitColor from '../assets/images/logos/pura-fruit.png';
import logoSavarAzul from '../assets/images/logos/savar-azul.jpg';
import logoSavarColor from '../assets/images/logos/savar.jpg';
import logoServiFabrickAzul from '../assets/images/logos/servifabrick-azul.png';
import logoServiFabrickColor from '../assets/images/logos/servifabrick.png';
import logoUnionAzul from '../assets/images/logos/union-azul.png';
import logoUnionColor from '../assets/images/logos/union.png';

const clientes = [
  {
    nombre: "Boart Longyear",
    logoAzul: logoBoartLongyearAzul,
    logoColor: logoBoartLongyearBlanco,
    isWhite: true,
    alt: "Boart Longyear cliente de R&A Racks"
  },
  {
    nombre: "Cerro Verde",
    logoAzul: logoCerroVerdeAzul,
    logoColor: logoCerroVerdeColor,
    isWhite: false,
    alt: "Sociedad Minera Cerro Verde"
  },
  {
    nombre: "Coreptec",
    logoAzul: logoCoreptecAzul,
    logoColor: logoCoreptecColor,
    isWhite: false,
    alt: "Coreptec soluciones industriales"
  },
  {
    nombre: "Danper",
    logoAzul: logoDanperAzul,
    logoColor: logoDanperColor,
    isWhite: true,
    alt: "Danper cliente estratégico"
  },
  {
    nombre: "Friopacking",
    logoAzul: logoFriopackingAzul,
    logoColor: logoFriopackingColor,
    isWhite: true,
    alt: "Friopacking almacenamiento en frío"
  },
  {
    nombre: "Frioteam",
    logoAzul: logoFrioteamAzul,
    logoColor: logoFrioteamColor,
    isWhite: true,
    alt: "Frioteam soluciones logísticas"
  },
  {
    nombre: "Soltrak",
    logoAzul: logoSoltrackAzul,
    logoColor: logoSoltrackColor,
    isWhite: false,
    alt: "Soltrak Ferreycorp"
  },
  {
    nombre: "Overall",
    logoAzul: logoOverallAzul,
    logoColor: logoOverallColor,
    isWhite: false,
    alt: "Overall Business"
  },
  {
    nombre: "Pura Fruit",
    logoAzul: logoPuraFruitAzul,
    logoColor: logoPuraFruitColor,
    isWhite: true,
    alt: "Pura Fruit sector agroindustrial"
  },
  {
    nombre: "Savar",
    logoAzul: logoSavarAzul,
    logoColor: logoSavarColor,
    isWhite: false,
    alt: "Savar Agentes de Aduana"
  },
  {
    nombre: "Servifabrick",
    logoAzul: logoServiFabrickAzul,
    logoColor: logoServiFabrickColor,
    isWhite: false,
    alt: "Servifabrick ingeniería"
  },
  {
    nombre: "Union",
    logoAzul: logoUnionAzul,
    logoColor: logoUnionColor,
    isWhite: false,
    alt: "Productos Union"
  }
];
---

<MainLayout>
  <main>
    <section class="relative h-[460px] lg:h-[600px] overflow-hidden">

      <Image src={bannerInicio}
          alt="Clientes corporativos y empresas que confían en nuestras soluciones de almacenamiento"
          class="w-full h-full object-cover transition-transform duration-[2000ms] hover:scale-110"
          loading="eager"
          fetchpriority="high"
          quality="mid"
          width={1920}
          height={1080}/>

      <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent"></div>

      <div class="absolute inset-0 flex items-end">
          <div class="max-w-[1200px] mx-auto px-6 pb-12 w-full">

            <nav class="mb-4 flex items-center gap-2 text-blue-400 text-xs md:text-sm font-bold uppercase tracking-widest" aria-label="Breadcrumb">
              <a href="/" class="hover:text-white transition-colors">Inicio</a>
              <span class="text-gray-500">/</span>
              <span class="text-white/80">Confianza y Respaldo</span>
            </nav>
            
            <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold text-white leading-tight drop-shadow-lg max-w-4xl">
                Nuestros Clientes y Aliados Estratégicos
            </h1>
            
            <div class="w-24 h-2 bg-blue-600 mt-6 rounded-full shadow-lg shadow-blue-900/50"></div>

            <p class="text-gray-200 mt-6 text-lg md:text-xl max-w-3xl font-medium leading-relaxed drop-shadow-md">
              En <strong class="text-white">R&A Racks</strong>, el éxito de nuestra gestión se refleja en la confianza sostenida de las empresas líderes del sector industrial y logístico que apuestan por nuestra excelencia operativa.
            </p>
          </div>
        </div>
      </section>

    <section class="max-w-[1200px] mx-auto px-5 py-16 md:py-24">
      <header class="max-w-3xl mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
          Socios que impulsan nuestra excelencia
        </h2>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
          Colaboramos con empresas líderes en los sectores minero, industrial y logístico, brindando 
          <strong>soluciones de almacenaje de alta ingeniería</strong> que permiten optimizar sus operaciones y crecer juntos.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12 items-center">
          {clientes.map((cliente) => (
              <div class={`group relative flex items-center justify-center p-8 rounded-xl transition-all duration-500 
                ${cliente.isWhite ? 'hover:bg-[#001F4D]' : 'hover:bg-gray-100'}`}>
                
                <div class="relative h-16 w-full flex items-center justify-center">

                  <Image 
                        src={cliente.logoAzul}
                        alt={cliente.alt}
                        class="absolute max-h-full max-w-full object-contain transition-all duration-500 group-hover:opacity-0 group-hover:scale-90"
                        loading="lazy"/>

                  <Image 
                        src={cliente.logoColor}
                        alt={cliente.alt}
                        class="absolute max-h-full max-w-full object-contain opacity-0 scale-110 transition-all duration-500 group-hover:opacity-100 group-hover:scale-100"
                        loading="lazy"/>

                </div>
              </div>
            ))}
        </div>
      </section>
  </main>
</MainLayout>
