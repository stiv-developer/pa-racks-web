---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

const title = "Racks Industriales en Lima | Venta y Fabricación al Mejor Precio - P&A Racks";
const description = "Fabricación y venta de racks industriales metálicos en Lima. Instalación profesional y estructuras de alta resistencia para almacenes. Cotiza hoy mismo.";

---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stiv-developer.github.io" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="relative">
    <Navbar />
    <main></main>
    <Sidebar />

    <slot />
    <Footer />
    <div class="fixed bottom-6 right-6 z-50">
      <a
        href="https://wa.me/51923808882?text=Hola,%20quiero%20más%20información%20sobre%20sus%20servicios"
        target="_blank"
        rel="noopener noreferrer"
        class="block hover:scale-110 transition-transform duration-300"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/iconos/whatsapp.webp`}
          alt="WhatsApp"
          class="w-16 md:w-20"
        />
      </a>
    </div>
  </body>
</html>
