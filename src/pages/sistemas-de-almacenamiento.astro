---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import banner from "../assets/images/servicios/sistemas-de-almacenamiento/nosotros-hero.jpg";
import rackSelectivo from "../assets/images/servicios/sistemas-de-almacenamiento/rack-selectivo.jpeg";
import rackAcumulativo from "../assets/images/servicios/sistemas-de-almacenamiento/rack-acumulativo.jpeg";
import cantilever from "../assets/images/servicios/sistemas-de-almacenamiento/cantilever.jpeg";
import rackAutoportante from "../assets/images/servicios/sistemas-de-almacenamiento/autoportante.jpeg";
import miniRack from "../assets/images/servicios/sistemas-de-almacenamiento/mini-racks.jpeg";
import entrepiso from "../assets/images/servicios/sistemas-de-almacenamiento/rack-entrepiso.jpeg";
import estanteriaMetalicaFija from "../assets/images/servicios/sistemas-de-almacenamiento/estanteria-fija.jpeg";
import estanteriaMetalicaMovil from "../assets/images/servicios/sistemas-de-almacenamiento/estanteria-movil.jpeg";
import mezzanine from "../assets/images/servicios/sistemas-de-almacenamiento/mezanine.jpeg";

const projects = [
  {
    title: "RACK SELECTIVO",
    slug: "rack-selectivo",
    category: "pesada",
    description:
      "Sistema de almacenamiento versátil para pallets que permite acceso directo a cada unidad de carga. Ideal para almacenes con alta rotación y gran variedad de productos.",
    image: rackSelectivo,
  },
  {
    title: "RACK ACUMULATIVO",
    slug: "rack-acumulativo",
    category: "pesada",
    description:
      "Sistema compacto diseñado para maximizar el aprovechamiento del espacio mediante almacenamiento por acumulación. Perfecto para productos homogéneos y alto volumen.",
    image: rackAcumulativo,
  },
  {
    title: "CANTILEVER",
    slug: "cantilever",
    category: "pesada",
    description:
      "Estructura especializada para el almacenamiento de cargas largas y voluminosas como tubos, perfiles o madera. Ofrece gran resistencia y fácil acceso frontal.",
    image: cantilever,
  },
  {
    title: "RACK AUTOPORTANTE",
    slug: "rack-autoportante",
    category: "pesada",
    description:
      "Sistema estructural que integra racks como soporte principal del edificio. Ideal para centros logísticos de gran altura y almacenamiento automatizado.",
    image: rackAutoportante,
  },
  {
    title: "MINI RACK",
    slug: "mini-rack",
    category: "semi",
    description:
      "Solución eficiente para almacenamiento manual de cargas medianas. Diseñado para optimizar espacios en almacenes, talleres y áreas de picking.",
    image: miniRack,
  },
  {
    title: "ENTREPISO RACK / ESTANTERIA",
    slug: "entrepiso-rack-estanteria",
    category: "semi",
    description:
      "Sistema que aprovecha la altura del almacén creando niveles adicionales de almacenamiento. Incrementa la capacidad sin necesidad de ampliar infraestructura.",
    image: entrepiso,
  },
  {
    title: "ESTANTERÍA METALICA FIJA",
    slug: "estanteria-metalica-fija",
    category: "ligera",
    description:
      "Estantería modular para almacenamiento liviano. Ideal para archivos, repuestos y productos de baja carga con acceso manual rápido y organizado.",
    image: estanteriaMetalicaFija,
  },
  {
    title: "ESTANTERÍA METALICA MOVIL",
    slug: "estanteria-metalica-movil",
    category: "ligera",
    description:
      "Sistema deslizante que optimiza el espacio eliminando pasillos innecesarios. Perfecto para archivos, bibliotecas y almacenes de espacio reducido.",
    image: estanteriaMetalicaMovil,
  },
  {
    title: "MEZZANINE ESTRUCTURAL",
    slug: "mezzanine-estructural",
    category: "especial",
    description:
      "Plataforma estructural diseñada para ampliar áreas operativas dentro de almacenes o plantas industriales. Solución ideal para oficinas, almacenamiento o producción.",
    image: mezzanine,
  },
];
---

<MainLayout>
  <main>
    <section class="relative h-[450px] lg:h-[600px] overflow-hidden">

      <Image  
        src={banner} 
        alt="Sistemas de almacenamiento industrial y racks metálicos para logística"
        class="w-full h-full object-cover transition-transform duration-[2000ms] hover:scale-110"
        loading="eager"
        fetchpriority="high"/>

      <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent"></div>

      <div class="absolute inset-0 flex items-end">
        <div class="max-w-[1200px] mx-auto px-6 pb-12 w-full">

          <nav class="mb-4 flex items-center gap-2 text-blue-400 text-xs md:text-sm font-bold uppercase tracking-widest" aria-label="Breadcrumb">
            <a href={`${import.meta.env.BASE_URL}`} aria-label="Ir a la página de inicio de P&A Racks" class="hover:text-white transition-colors">Inicio</a>
            <span class="text-gray-500">/</span>
            <a href={`${import.meta.env.BASE_URL}negocios`} class="hover:text-white transition-colors">Negocios</a>
            <span class="text-gray-500">/</span>
            <span class="text-white/80">Sistemas de Almacenamiento</span>
          </nav>

          <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold text-white leading-tight drop-shadow-lg max-w-4xl">
            Sistemas de Almacenamiento e Ingeniería Logística
          </h1>

          <div class="w-24 h-2 bg-blue-600 mt-6 rounded-full shadow-lg shadow-blue-900/50"></div>

          <p class="text-gray-200 mt-6 text-lg md:text-xl max-w-3xl font-medium leading-relaxed drop-shadow-md">
            Diseñamos soluciones eficientes con racks industriales para todo tipo de cargas, optimizando la capacidad y operatividad de su almacén.
          </p>
        </div>
      </div>
    </section>

    <div class="max-w-[1200px] mx-auto px-5 py-16">
  
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-4">Nuestro Catálogo de Soluciones</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg">
          Seleccione el tipo de carga para encontrar el sistema de almacenamiento que mejor se adapte a su operativa logística.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 mb-12 bg-gray-50 p-2 rounded-2xl border border-gray-100 shadow-sm">
        <button data-filter="pesada" class="filter-btn active-btn">
          <span class="hidden md:inline">🏗️</span> Carga Pesada
        </button>
        <button data-filter="semi" class="filter-btn">
          <span class="hidden md:inline">📦</span> Carga Semipesada
        </button>
        <button data-filter="ligera" class="filter-btn">
          <span class="hidden md:inline">📄</span> Carga Ligera
        </button>
        <button data-filter="especial" class="filter-btn">
          <span class="hidden md:inline">⚙️</span> Estructuras Especiales
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 min-h-[600px]" id="projects-container">
        {projects.map((project) => (
          <article 
            class="project-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-3 flex flex-col border border-gray-100"
            data-category={project.category}
          >
            <div class="relative overflow-hidden h-[240px]">
              <div class="absolute top-4 left-4 z-10">
                <span class="bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-tighter">
                  {project.category === 'pesada' ? 'Industrial' : project.category}
                </span>
              </div>

              <Image 
                  src={project.image}
                  alt={`Instalación de ${project.title} - R&A Racks Perú`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"/>
            </div>

            <div class="p-8 flex flex-col flex-grow">
              <h3 class="text-2xl font-extrabold text-[#00388B] mb-4 group-hover:text-blue-600 transition-colors uppercase leading-tight">
                {project.title}
              </h3>
              <p class="text-gray-600 leading-relaxed mb-8 text-sm flex-grow">
                {project.description}
              </p>
              
              <div class="mt-auto border-t border-gray-50 pt-6">
                <a href={`/racks-industriales/${project.slug}`} 
                  class="inline-flex items-center gap-2 text-blue-600 font-bold text-base hover:gap-4 transition-all">
                  Ficha Técnica y Detalles
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .filter-btn {
    @apply px-6 py-3 rounded-xl bg-white text-gray-500 font-bold text-sm md:text-base border border-gray-200 transition-all duration-300 hover:border-blue-400 hover:text-blue-600 flex items-center gap-2;
  }

  .active-btn {
    @apply bg-[#00388B] text-white border-[#00388B] shadow-lg shadow-blue-900/20;
  }

  /* Animación de entrada para las cards */
  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .project-card[style*="display: block"] {
    animation: fadeInScale 0.4s ease forwards;
  }
</style>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");

  const defaultCategory = "pesada";

  function filterProjects(category) {
    cards.forEach(card => {
      if (card.dataset.category === category) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  }

  // Evento click
  buttons.forEach(button => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      buttons.forEach(btn => btn.classList.remove("active-btn"));
      button.classList.add("active-btn");

      filterProjects(filter);
    });
  });

  // 🔥 Aplicar filtro al cargar
  document.addEventListener("DOMContentLoaded", () => {
    filterProjects(defaultCategory);

    const defaultBtn = document.querySelector(`[data-filter="${defaultCategory}"]`);
    defaultBtn?.classList.add("active-btn");
  });
</script>