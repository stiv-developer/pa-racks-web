---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "Mantenimiento de techo en Chorrillos",
    slug: "mantenimiento-de-techos-industriales",
    image: "images/img-proyectos/mantenimiento-de-techo/mantenimiento-de-techo-7.jpeg",
  },
  {
    title: "Armado de mini racks en Huachipa",
    slug: "instalación-y-armado-de-mini-racks",
    image: "images/img-proyectos/armado-de-mini-racks/armado-de-mini-racks-1.jpeg",
  }
];
---

<MainLayout>
  <main>
    <div class="relative">
      <div>
        <img
          src={`${import.meta.env.BASE_URL}images/banner/nosotros-hero.jpg`}
          alt="nosotros"
          class="h-[400px] md:w-full h-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-black/40"></div>

      <div class="absolute bottom-[10%] left-[20%]">
        <p class="text-5xl md:text-6xl font-bold text-white">
          Proyectos ejecutados
        </p>
      </div>
    </div>

    <div class="max-w-[1200px] mx-auto px-5 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        {
          projects.map((project) => (
                  <article class="group relative overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-all duration-500">

        <a href={`/proyectos/${project.slug}`} class="block relative">

          <img 
            src={`${import.meta.env.BASE_URL}${project.image}`}
            alt={`${project.title} sistema de almacenamiento industrial`}
            class="w-full h-[300px] object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent opacity-80 group-hover:opacity-90 transition"></div>

          <div class="absolute bottom-0 left-0 p-5 w-full">

            <h2 class="text-white text-xl md:text-2xl font-bold">
              {project.title}
            </h2>

            <p class="text-gray-200 text-sm mt-2 opacity-0 group-hover:opacity-100 transition duration-500">
              Ver más detalles →
            </p>

          </div>

        </a>

      </article>
          ))
        }
      </div>
    </div>
  </main>
</MainLayout>
