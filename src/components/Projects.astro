---
const projects = [
  {
    title: "Decor Center - Autoportante",
    category: "ALMACENAMIENTO",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  },
  {
    title: "Proyecto Logístico Norte",
    category: "ALMACENAMIENTO",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  },
  {
    title: "Centro Industrial Sur",
    category: "ALMACENAMIENTO",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  },
  {
    title: "Proyecto Internacional",
    category: "ALMACENAMIENTO",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  },
  {
    title: "Proyecto Energético",
    category: "ALMACENAMIENTO",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  },
  {
    title: "Proyecto Minero",
    category: "ALMACENAMIENTO",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  }
];
---

<section class="py-16 md:mt-[160px] px-4 flex justify-center">

  <div class="w-full max-w-[1250px]">

    <h3 class="text-center font-bold text-4xl md:text-5xl">
      Proyectos
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">

      {projects.map((project) => (

        <div class="relative overflow-hidden cursor-pointer group">

          <img 
            src={`${import.meta.env.BASE_URL}${project.image}`}
            alt={project.title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />

          <!-- Bandera -->
          <div class="absolute top-3 right-3 
                      w-[65px] h-[65px] 
                      rounded-full overflow-hidden 
                      border-4 border-white bg-white">
            {/* <img 
              src={project.flag} 
              alt="País"
              class="w-full h-full object-cover"
            /> */}

            <img 
              src={`${import.meta.env.BASE_URL}${project.flag}`} 
              alt="País"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Texto -->
          <div class="absolute bottom-4 left-4">
            <div class="flex flex-col">
              <p class="bg-white px-3 py-1 font-bold text-lg">
                {project.title}
              </p>
              <p class="bg-[#FFA100] px-3 py-1 text-lg">
                {project.category}
              </p>
            </div>
          </div>

        </div>

      ))}

    </div>

    <div class="flex items-center justify-center mt-10">
      <a 
        href={`${import.meta.env.BASE_URL}proyectos`}
        class="inline-block bg-[#00388B] text-white font-bold py-4 px-10 text-lg hover:bg-[#002c6e] transition"
      >
        Ver más proyectos
      </a>

    </div>

  </div>

</section>
