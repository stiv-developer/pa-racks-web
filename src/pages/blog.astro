---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// 1. Obtenemos todas las entradas del blog y las ordenamos por fecha (la más reciente primero)
const posts = await getCollection("blog");
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MainLayout title="Blog de Ingeniería y Almacenamiento | P&A RACKS">
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      
      <div class="mb-16 text-center">
        <h1 class="text-5xl md:text-7xl font-black text-[#00388B] uppercase tracking-tighter mb-4">
          Nuestro <span class="text-[#FFA100]">Blog</span>
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Expertos compartiendo conocimientos sobre seguridad, mantenimiento y optimización de almacenes industriales en el Perú.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <a 
            href={`/blog/${post.slug}`} 
            class="group bg-white rounded-3xl overflow-hidden shadow-lg shadow-blue-900/5 border border-slate-100 transition-all hover:-translate-y-2 hover:shadow-2xl hover:shadow-blue-900/10"
          >
            <div class="relative h-64 overflow-hidden">
              <Image 
                src={post.data.image} 
                alt={post.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
              <div class="absolute top-4 left-4 flex gap-2">
                {post.data.tags.slice(0, 2).map(tag => (
                  <span class="bg-[#00388B] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="p-8">
              <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">
                {post.data.pubDate.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
              <h2 class="text-2xl font-black text-[#00388B] uppercase tracking-tight leading-none mb-4 group-hover:text-[#FFA100] transition-colors">
                {post.data.title}
              </h2>
              <p class="text-slate-600 line-clamp-3 text-sm leading-relaxed mb-6">
                {post.data.description}
              </p>
              <div class="flex items-center text-[#00388B] font-black text-xs uppercase tracking-widest">
                Leer artículo 
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>