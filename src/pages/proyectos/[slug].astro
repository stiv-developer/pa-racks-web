---
import { projects } from "../../data/projects";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project }
    }))
}

const { project } = Astro.props;
---

<MainLayout>
    <main>

        <section class="relative h-[300px] md:h-[450px] lg:h-[600px] overflow-hidden">
            <img 
                src={`${import.meta.env.BASE_URL}${project.image_banner}`}
                alt={`Proyecto de ingeniería: ${project.title}`}
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
                fetchpriority="high"
            >

            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

            <div class="absolute inset-0 flex items-end">
                <div class="max-w-[1200px] mx-auto px-6 pb-12 w-full">
                    <nav class="mb-4 flex items-center gap-2 text-blue-400 text-sm font-medium uppercase tracking-widest" aria-label="Breadcrumb">
                        <span>Proyectos</span>
                        <span class="text-gray-400">/</span>
                        <span class="text-white/80">{project.ubication}</span>
                    </nav>
                    
                    <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight drop-shadow-lg">
                        {project.title}
                    </h1>
                    
                    <div class="w-20 h-1.5 bg-blue-600 mt-6 rounded-full"></div>
                </div>
            </div>
        </section>

        <section class="max-w-[1200px] mx-auto px-5 py-10 md:py-[100px] bg-white">

            <header class="mb-10">
                <h2 class="text-2xl md:text-4xl font-bold leading-tight text-gray-900">
                    {project.sub_title}
                </h2>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-10 gap-8">
                <article class="col-span-1 md:col-span-7">
                    <h3 class="text-xl md:text-2xl font-semibold text-gray-800 mb-6 flex items-center gap-2">
                        <span class="w-8 h-1 bg-blue-600 inline-block"></span>
                        Alcance del proyecto:
                    </h3>
                    
                    <ul class="space-y-4">
                        {project.items?.map((item) => (
                            <li class="flex gap-3 items-start py-1">
                                <img 
                                    src={`${import.meta.env.BASE_URL}images/iconos/check-b.svg`} 
                                    alt={`Logro: ${item}`} 
                                    class="w-6 h-6 mt-1 flex-shrink-0"
                                    loading="lazy"
                                />
                                <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                                    {item}
                                </p>
                            </li>
                        ))}
                    </ul>
                </article>

                <aside class="col-span-1 md:col-span-3 bg-gray-50 p-6 rounded-xl border border-gray-100 flex flex-col gap-6">

                        {project.client && (
                                <div class="flex flex-col gap-2 pt-0 first:pt-0"> 
                                    <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Cliente:</span>
                                    <div class="flex items-center gap-3">
                                        <img src={`${import.meta.env.BASE_URL}images/iconos/cliente-icon.svg`} alt="Cliente" class="w-6 h-6" />
                                        <p class="font-medium text-gray-800">{project.client}</p>
                                    </div>
                                </div>
                            )}

                            {project.ubication && (
                                <div class="flex flex-col gap-2 pt-6 first:pt-0 border-none">
                                    <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Ubicación:</span>
                                    <div class="flex items-center gap-3">
                                        <img src={`${import.meta.env.BASE_URL}images/iconos/gps-icon.svg`} alt="Ubicación" class="w-6 h-6" />
                                        <p class="font-medium text-gray-800">{project.ubication}</p>
                                    </div>
                                </div>
                            )}

                            {project.time && (
                                <div class="flex flex-col gap-2 pt-6 first:pt-0 border-none">
                                    <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Tiempo:</span>
                                    <div class="flex items-center gap-3">
                                        <img src={`${import.meta.env.BASE_URL}images/iconos/date-icon.svg`} alt="Duración" class="w-6 h-6" />
                                        <p class="font-medium text-gray-800">{project.time}</p>
                                    </div>
                                </div>
                            )}
                    
                            {project.area && (
                                    <div class="flex flex-col gap-2 first:pt-0">
                                        <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Área:</span>
                                        <div class="flex items-center gap-3">
                                            <img src={`${import.meta.env.BASE_URL}images/iconos/area-icon.svg`} alt="Duración de la obra" class="w-6 h-6" />
                                            <p class="font-medium text-gray-800">{project.area}</p>
                                        </div>
                                    </div>
                                )}
                   
                </aside>
            </div>
        </section>
        <section class="max-w-[1200px] mx-auto p-4 md:p-6">
            <div class="relative w-full aspect-video md:h-[600px] overflow-hidden rounded-lg bg-gray-100">
                <img id="mainImage"
                    src={`${import.meta.env.BASE_URL}${project.images[0]}`}
                    class="w-full h-full object-cover transition-opacity duration-500"
                    alt="Imagen principal del proyecto"
                />
            </div>

            <div class="flex items-center gap-2 mt-4">
                <button id="prevBtn" class="nav-btn"> ❮ </button>

                <div id="thumbContainer" class="flex gap-2 overflow-x-auto scroll-smooth no-scrollbar py-2">
                    {project.images?.map((img, index) => (
                        <img
                            src={`${import.meta.env.BASE_URL}${img}`}
                            class={`thumb ${index === 0 ? "active-thumb" : ""}`}
                            alt={`Miniatura ${index + 1}`}
                            data-index={index}
                        />
                    ))}
                </div>

                <button id="nextBtn" class="nav-btn"> ❯ </button>
            </div>
        </section>
    </main>
</MainLayout>

<style>
  /* Evita que las miniaturas se encojan y define tamaño fijo */
  .thumb {
    @apply w-[80px] h-[60px] md:w-[120px] md:h-[80px] flex-shrink-0 object-cover cursor-pointer opacity-50 transition-all duration-300 rounded-md border-2 border-transparent;
  }

  .thumb:hover {
    @apply opacity-100;
  }

  .active-thumb {
    @apply opacity-100 border-blue-600 scale-105;
  }

  /* Botones de navegación */
  .nav-btn {
    @apply text-2xl md:text-4xl px-2 py-1 text-gray-600 hover:text-black transition-colors;
  }

  /* Ocultar scrollbar pero mantener funcionalidad */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const mainImage = document.getElementById("mainImage");
  const thumbnails = document.querySelectorAll(".thumb");
  const thumbContainer = document.getElementById("thumbContainer");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");

  let currentIndex = 0;

  function updateImage(index) {
    currentIndex = index;
    const selectedThumb = thumbnails[index];

    // Cambio de imagen con efecto suave
    mainImage.style.opacity = "0.7";
    setTimeout(() => {
        mainImage.src = selectedThumb.src;
        mainImage.style.opacity = "1";
    }, 100);

    // Actualizar clases de miniaturas
    thumbnails.forEach(t => t.classList.remove("active-thumb"));
    selectedThumb.classList.add("active-thumb");

    // Centrar automáticamente la miniatura activa en el scroll
    const scrollOffset = selectedThumb.offsetLeft - (thumbContainer.offsetWidth / 2) + (selectedThumb.offsetWidth / 2);
    thumbContainer.scrollTo({ left: scrollOffset, behavior: 'smooth' });
  }

  thumbnails.forEach((thumb, index) => {
    thumb.addEventListener("click", () => updateImage(index));
  });

  prevBtn.addEventListener("click", () => {
    currentIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    updateImage(currentIndex);
  });

  nextBtn.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % thumbnails.length;
    updateImage(currentIndex);
  });
</script>