---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "Decor Center - Autoportante",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Logístico Norte",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Centro Industrial Sur",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Internacional",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Energético",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Minero",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Minero",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Minero",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
  {
    title: "Proyecto Minero",
    category: "ALMACENAMIENTO",
    image: "/images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "/images/peru-flag.png",
  },
];
---

<MainLayout>
  <main>
    <div class="relative">
      <div>
        <img
          src={`${import.meta.env.BASE_URL}images/banner/nosotros-hero.jpg`}
          alt="nosotros"
          class="h-[400px] md:w-full h-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-black/40"></div>

      <div class="absolute bottom-[10%] left-[20%]">
        <p class="text-5xl md:text-6xl font-bold text-white">
          Proyectos ejecutados
        </p>
      </div>
    </div>

    <div class="max-w-[1200px] mx-auto px-5 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        {
          projects.map((project) => (
            <div class="relative overflow-hidden cursor-pointer group">
              <img
                src={`${import.meta.env.BASE_URL}${project.image}`}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />

              <div
                class="absolute inset-0 bg-[#FFA100]/0 
                transition-all duration-500
                group-hover:bg-[#FFA100]/80"
              ></div>

              <div
                class="absolute top-3 right-3 
                        w-[65px] h-[65px] 
                        rounded-full overflow-hidden 
                        border-4 border-white bg-white"
              >
                <img
                  src={`${import.meta.env.BASE_URL}${project.flag}`}
                  alt="País"
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="absolute bottom-4 left-4 z-20 transition-all duration-300
            group-hover:opacity-0 group-hover:translate-y-4">
                <div class="flex flex-col">
                  <p class="bg-[#FFA100] px-3 py-1 text-lg">{project.title}</p>
                </div>
              </div>

              <div
                class="absolute inset-0 flex items-center justify-center 
                text-black text-center px-6
                opacity-0 translate-y-5
                transition-all duration-500
                group-hover:opacity-100 group-hover:translate-y-0 z-20"
              >
                <div>
                  <p class="text-xl font-bold mb-2 font-bold">{project.title}</p>
                  <p class="text-sm">
                    Proyecto desarrollado con soluciones logísticas integrales y
                    estructuras de alto rendimiento.
                  </p>
                </div>
              </div>
              
              <div class="absolute bottom-2 right-3 opacity-0 translate-y-5 group-hover:opacity-100 group-hover:translate-y-0">
                <p class="font-bold">Ver más</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</MainLayout>
