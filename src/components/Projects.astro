---
const projects = [
  {
    title: "Mantenimeinto de techo",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  },
  {
    title: "Armado de mini racks",
    image: "images/img-proyectos/decor-efecto-autoportante.jpg",
    flag: "images/peru-flag.png"
  }
];
---

<section class="py-16 md:mt-[160px] px-4 flex justify-center">

  <div class="w-full max-w-[1250px]">

    <div class="relative flex justify-between bg-[#00388B] py-5 md:py-10 px-3">

      <h3 class="relative text-start font-bold text-4xl md:text-5xl text-white">NUESTROS PROYECTOS</h3>
      <div class="hidden md:block">
        <img src="images/persona.png" alt="persona" class="h-[400px] absolute right-2 top-[-150px]">
      </div>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">

    {projects.map((project) => (

      <article class="group relative overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-all duration-500">

        <a href={`/proyectos/${project.slug}`} class="block relative">

          <img 
            src={`${import.meta.env.BASE_URL}${project.image}`}
            alt={`${project.title} sistema de almacenamiento industrial`}
            class="w-full h-[300px] object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent opacity-80 group-hover:opacity-90 transition"></div>

          <div class="absolute bottom-0 left-0 p-5 w-full">

            <h2 class="text-white text-xl md:text-2xl font-bold">
              {project.title}
            </h2>

            <p class="text-gray-200 text-sm mt-2 opacity-0 group-hover:opacity-100 transition duration-500">
              Ver más detalles →
            </p>

          </div>

        </a>

      </article>

    ))}

    </div>

    <div class="flex items-center justify-center mt-10">
      <a 
        href={`${import.meta.env.BASE_URL}proyectos`}
        class="inline-block bg-[#00388B] text-white font-bold py-4 px-10 text-lg hover:bg-[#002c6e] transition"
      >
        Ver más proyectos
      </a>

    </div>

  </div>

</section>
