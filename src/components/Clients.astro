---

import {Image} from "astro:assets";
import friopacking from "../assets/images/logos/friopacking.png";
import danper from "../assets/images/logos/danper.svg";
import puraFruit from "../assets/images/logos/pura-fruit.png";
import savar from "../assets/images/logos/savar.jpg";
import boartLongyear from "../assets/images/logos/boart-longyear.webp";
import union from "../assets/images/logos/union.png";
import cerroVerde from "../assets/images/logos/cerro_verde.png";
import coreptec from "../assets/images/logos/coreptec.svg";
import frioteam from "../assets/images/logos/frioteam.svg";
import soltrack from "../assets/images/logos/logo_soltrak.png";
import overall from "../assets/images/logos/overall_blue.svg";
import servifabrick from "../assets/images/logos/servifabrick.png";

const clients = [
  { 
    src: cerroVerde, 
    alt: "Sociedad Minera Cerro Verde - Proyectos de almacenamiento minero por P&A Racks",
    nombre: "Cerro Verde" 
  },
  { 
    src: danper, 
    bg: "bg-red-800",
    alt: "Danper - Instalación de racks industriales para el sector agroindustrial",
    nombre: "Danper" 
  },
  { 
    src: friopacking, 
    bg: "bg-gray-800",
    alt: "Friopacking - Soluciones de racks para cámaras de frío y logística",
    nombre: "Friopacking" 
  },
  { 
    src: puraFruit, 
    bg: "bg-gray-800",
    alt: "Pura Fruit - Implementación de sistemas de almacenamiento agroindustrial",
    nombre: "Pura Fruit"
  },
  { 
    src: savar,
    alt: "Savar Corporación Logística - Cliente estratégico de racks y estructuras metálicas",
    nombre: "Savar" 
  },
  { 
    src: boartLongyear,
    bg: "bg-gray-500",
    alt: "Boart Longyear - Estructuras metálicas para el sector minero e industrial",
    nombre: "Boart Longyear"
  },
  { 
    src: union, 
    alt: "Empresa Unión - Proyectos de optimización de almacenes por P&A Racks",
    nombre: "Union" 
  },
  { 
    src: servifabrick, 
    alt: "Servifabrick - Mantenimiento preventivo de racks industriales",
    nombre: "Servifabrick"  
  },
  { 
    src: soltrack, 
    alt: "Soltrak - Suministro e instalación de estanterías metálicas industriales",
    nombre: "Soltrak" 
  },
  { 
    src: coreptec, 
    alt: "Coreptec - Ingeniería y soluciones de almacenamiento de alta carga",
    nombre: "Coreptec"
  },
  { 
    src: overall, 
    alt: "Overall Business - Gestión logística y racks de almacenamiento",
    nombre: "Overall"
  },
  { 
    src: frioteam, 
    bg: "bg-sky-950",
    alt: "Frioteam - Especialistas en refrigeración y racks para frío industrial",
    nombre: "Frioteam" 
  },
];
---

<section class="py-16 md:py-24 md:py-20 bg-gray-50 overflow-hidden">
  <div class="max-w-[1200px] mx-auto px-4">

    <div class="flex items-center gap-4 mb-12">

      <h2 class="text-3xl md:text-5xl font-black text-[#00388B] uppercase tracking-tighter">
        Nuestros Clientes
      </h2>

      <div class="flex-grow h-[2px] bg-[#00388B]/10"></div>

    </div>

    <div class="flex items-center gap-2 md:gap-4 my-12">
      
      <button id="prevBtn2" class="text-2xl md:text-3xl px-2 md:px-3"> ❮</button>

      <div id="carousel2" class="flex gap-6 md:gap-12 overflow-hidden scroll-smooth w-full">
        {
          clients.map((client) => (
            <div class={`flex items-center justify-center p-2 rounded-md shrink-0 ${client.bg ?? ""}`}>

              <Image src={client.src} alt={client.alt} class="h-10 md:h-12 lg:h-14 w-auto" quality="mid" loading="lazy"/>
              
            </div>
          ))
        }
      </div>

      <button id="nextBtn2" class="text-2xl md:text-3xl px-2 md:px-3"> ❯ </button>
    </div>

      <div class="mt-12 flex justify-center">
        <a href="/clientes" class="group flex flex-col items-center">
          <span class="text-[#00388B] text-xl font-bold group-hover:text-blue-500 transition-colors">Ver portafolio de clientes</span>
          <div class="bg-[#FFA100] w-12 h-[4px] mt-1 group-hover:w-full transition-all duration-300"></div>
        </a>
      </div>
  </div>
</section>

<script>
  const carousel:any = document.getElementById("carousel2");
  const nextBtn = document.getElementById("nextBtn2");
  const prevBtn = document.getElementById("prevBtn2");

  function getScrollAmount() {
    return carousel.clientWidth * 0.8; 
  }

  nextBtn?.addEventListener("click", () => {
    carousel.scrollBy({
      left: getScrollAmount(),
      behavior: "smooth",
    });
  });

  prevBtn?.addEventListener("click", () => {
    carousel.scrollBy({
      left: -getScrollAmount(),
      behavior: "smooth",
    });
  });
</script>
