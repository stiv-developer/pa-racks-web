---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "RACK SELECTIVO",
    slug: "rack-selectivo",
    category: "pesada",
    description:
      "Sistema de almacenamiento versátil para pallets que permite acceso directo a cada unidad de carga. Ideal para almacenes con alta rotación y gran variedad de productos.",
    image: "images/sistema-almacenamiento/rack-selectivo.jpeg",
  },
  {
    title: "RACK ACUMULATIVO",
    slug: "rack-acumulativo",
    category: "pesada",
    description:
      "Sistema compacto diseñado para maximizar el aprovechamiento del espacio mediante almacenamiento por acumulación. Perfecto para productos homogéneos y alto volumen.",
    image: "images/sistema-almacenamiento/rack-acumulativo.jpeg",
  },
  {
    title: "CANTILEVER",
    slug: "cantilever",
    category: "pesada",
    description:
      "Estructura especializada para el almacenamiento de cargas largas y voluminosas como tubos, perfiles o madera. Ofrece gran resistencia y fácil acceso frontal.",
    image: "images/sistema-almacenamiento/cantilever.jpeg",
  },
  {
    title: "RACK AUTOPORTANTE",
    slug: "rack-autoportante",
    category: "pesada",
    description:
      "Sistema estructural que integra racks como soporte principal del edificio. Ideal para centros logísticos de gran altura y almacenamiento automatizado.",
    image: "images/sistema-almacenamiento/autoportante.jpeg",
  },
  {
    title: "MINI RACK",
    slug: "mini-rack",
    category: "semi",
    description:
      "Solución eficiente para almacenamiento manual de cargas medianas. Diseñado para optimizar espacios en almacenes, talleres y áreas de picking.",
    image: "images/sistema-almacenamiento/mini-racks.jpeg",
  },
  {
    title: "ENTREPISO RACK / ESTANTERIA",
    slug: "entrepiso-rack-estanteria",
    category: "semi",
    description:
      "Sistema que aprovecha la altura del almacén creando niveles adicionales de almacenamiento. Incrementa la capacidad sin necesidad de ampliar infraestructura.",
    image: "images/sistema-almacenamiento/rack-entrepiso.jpeg",
  },
  {
    title: "ESTANTERÍA METALICA FIJA",
    slug: "estanteria-metalica-fija",
    category: "ligera",
    description:
      "Estantería modular para almacenamiento liviano. Ideal para archivos, repuestos y productos de baja carga con acceso manual rápido y organizado.",
    image: "images/sistema-almacenamiento/estanteria-fija.jpeg",
  },
  {
    title: "ESTANTERÍA METALICA MOVIL",
    slug: "estanteria-metalica-movil",
    category: "ligera",
    description:
      "Sistema deslizante que optimiza el espacio eliminando pasillos innecesarios. Perfecto para archivos, bibliotecas y almacenes de espacio reducido.",
    image: "images/sistema-almacenamiento/estanteria-movil.jpeg",
  },
  {
    title: "MEZZANINE ESTRUCTURAL",
    slug: "mezzanine-estructural",
    category: "especial",
    description:
      "Plataforma estructural diseñada para ampliar áreas operativas dentro de almacenes o plantas industriales. Solución ideal para oficinas, almacenamiento o producción.",
    image: "images/sistema-almacenamiento/mezanine.jpeg",
  },
];
---

<MainLayout>
  <main>
    <div class="relative">
      <div>
        <img
          src={`${import.meta.env.BASE_URL}images/banner/nosotros-hero.jpg`}
          alt="nosotros"
          class="h-[400px] md:w-full h-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-black/40"></div>

      <div class="absolute bottom-[10%] left-[5%] md:left-[20%]">
        <p class="text-3xl md:text-6xl font-bold text-white">
          Sistemas de Almacenamiento
        </p>
        <p class="text-2xl md:text-3xl font-medium text-white">
          Racks para todo tipo de cargas y equipamiento de almacenes
        </p>
      </div>
    </div>

    <div class="max-w-[1200px] mx-auto px-5 py-10">
      <div class="grid md:grid-cols-4 gap-3 shadow-2xl p-4">

      <button data-filter="pesada" class="filter-btn active-btn">
        Estructura para carga pesada
      </button>

      <button data-filter="semi" class="filter-btn">
        Estructura para carga semi pesada
      </button>

      <button data-filter="ligera" class="filter-btn">
        Estructura para carga ligera
      </button>

      <button data-filter="especial" class="filter-btn">
        Estructura especiales
      </button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 mb-[180px]" id="projects-container">
        {
          projects.map((project) => (
            <div 
              class="project-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2"
              data-category={project.category}
            >
              <div class="overflow-hidden h-[260px]">
                <img
                  src={`${import.meta.env.BASE_URL}${project.image}`}
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
              </div>

              <div class="p-6">
                <p class="text-2xl font-bold mb-3">
                  {project.title}
                </p>
                <p class="text-gray-600 leading-relaxed mb-6">
                  {project.description}
                </p>
                <a href={`/racks-industriales/${project.slug}`} class="inline-flex items-center gap-2 text-blue-600 font-semibold text-lg group-hover:gap-3 transition-all" > Conoce más <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" > <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /> </svg> </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .filter-btn {
    @apply p-4 rounded-lg bg-[#D4DAF5] font-bold cursor-pointer transition-all;
  }

  .active-btn {
    @apply bg-[#00388B] text-white;
  }
</style>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");

  const defaultCategory = "pesada";

  function filterProjects(category) {
    cards.forEach(card => {
      if (card.dataset.category === category) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  }

  // Evento click
  buttons.forEach(button => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      buttons.forEach(btn => btn.classList.remove("active-btn"));
      button.classList.add("active-btn");

      filterProjects(filter);
    });
  });

  // 🔥 Aplicar filtro al cargar
  document.addEventListener("DOMContentLoaded", () => {
    filterProjects(defaultCategory);

    const defaultBtn = document.querySelector(`[data-filter="${defaultCategory}"]`);
    defaultBtn?.classList.add("active-btn");
  });
</script>