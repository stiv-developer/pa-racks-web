---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "Mantenimiento de Techos Industriales",
    slug: "mantenimiento-de-techos-industriales",
    location: "Chorrillos, Lima",
    category: "Mantenimiento Industrial",
    image: "images/img-proyectos/mantenimiento-de-techo/mantenimiento-de-techo-7.jpeg",
  },
  {
    title: "Instalación y Armado de Mini Racks",
    slug: "instalacion-y-armado-de-mini-racks",
    location: "Huachipa, Lima",
    category: "Sistemas de Almacenamiento",
    image: "images/img-proyectos/armado-de-mini-racks/armado-de-mini-racks-1.jpeg",
  }
];
---

<MainLayout>
  <main>

    <section class="relative h-[300px] md:h-[450px] lg:h-[600px] overflow-hidden">
      <img 
        src={`${import.meta.env.BASE_URL}images/banner/nosotros-hero.jpg`}
        alt="Portafolio de proyectos ejecutados en sistemas de almacenamiento y construcción industrial"
        class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
        loading="eager"
        fetchpriority="high">

      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

      <div class="absolute inset-0 flex items-end">
        <div class="max-w-[1200px] mx-auto px-6 pb-12 w-full">

          <nav class="mb-4 flex items-center gap-2 text-blue-400 text-sm font-bold uppercase tracking-widest" aria-label="Breadcrumb">
            <a href="/" aria-label="Ir a la página de inicio de P&A Racks" class="hover:text-white transition-colors">Inicio</a>
            <span class="text-gray-500">/</span>
            <span class="text-white/80">Casos de Éxito</span>
          </nav>
          
          <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold text-white leading-tight drop-shadow-lg max-w-4xl">
              Nuestros Proyectos y Soluciones Logísticas
          </h1>
          
          <div class="w-24 h-2 bg-blue-600 mt-6 rounded-full shadow-lg"></div>

          <p class="text-gray-200 mt-6 text-lg md:text-xl max-w-2xl font-medium drop-shadow-md">
            Explora nuestra trayectoria en el diseño, montaje y mantenimiento de infraestructuras industriales de alta complejidad.
          </p>
        </div>
      </div>
    </section>
    <div class="max-w-[1200px] mx-auto px-5 py-16">
      <div class="mb-12">
        <h2 class="text-3xl font-bold text-gray-900 italic border-l-4 border-blue-600 pl-4">
          Casos de Éxito y Soluciones Ejecutadas
        </h2>
        <p class="text-gray-600 mt-2">Explora nuestra experiencia técnica en diferentes distritos de Lima.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => (
          <article class="group relative overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 bg-gray-900">
            <a href={`/proyectos/${project.slug}`} class="block relative h-[400px]">
              
              <img 
                src={`${import.meta.env.BASE_URL}${project.image}`}
                alt={`${project.title} en ${project.location} - Ingeniería Logística`}
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 opacity-80 group-hover:opacity-100"
                loading="lazy"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>

              <div class="absolute top-4 left-4">
                <span class="bg-blue-600 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full shadow-lg">
                  {project.category}
                </span>
              </div>

              <div class="absolute bottom-0 left-0 p-6 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                <div class="flex items-center gap-2 text-blue-400 text-xs font-semibold mb-2">
                  <img src={`${import.meta.env.BASE_URL}images/iconos/gps-icon.svg`} class="w-3 h-3 invert" alt="Ubicación" />
                  <span>{project.location}</span>
                </div>

                <h3 class="text-white text-xl md:text-2xl font-bold leading-tight">
                  {project.title}
                </h3>

                <div class="flex items-center gap-2 mt-4 text-white font-semibold text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                  <span class="border-b-2 border-blue-500 pb-1">Ver detalles del proyecto</span>
                  <span class="text-blue-400">→</span>
                </div>
              </div>
            </a>
          </article>
        ))}
        
        <div class="hidden lg:flex flex-col justify-center items-center border-2 border-dashed border-gray-300 rounded-2xl p-10 text-center grayscale opacity-50">
          <p class="text-gray-400 font-medium italic">Estamos documentando nuevos proyectos en Lima y provincias...</p>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
