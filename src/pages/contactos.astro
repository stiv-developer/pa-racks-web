---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import nosotrosHero from '../assets/images/banner/nosotros-hero.jpg';
import planta from '../assets/images/contactos/Planta-JRM.jpg';
---

<MainLayout>
  <main>
    <section class="relative h-[400px] md:h-[450px] lg:h-[550px] overflow-hidden">

      <Image 
            src={nosotrosHero}
            alt="Oficinas de atención y soporte técnico de R&A Racks en Lima"
            class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
            loading="eager"
            fetchpriority="high"
            quality="mid"
            width={1920}
            height={1080}/>

      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

      <div class="absolute inset-0 flex items-end">
        <div class="max-w-[1200px] mx-auto px-6 pb-12 w-full">
          
          <nav class="mb-4 flex items-center gap-2 text-blue-400 text-sm font-bold uppercase tracking-widest" aria-label="Breadcrumb">
            <a href="/" class="hover:text-white transition-colors">Inicio</a>
            <span class="text-gray-500">/</span>
            <span class="text-white/80">Atención al Cliente</span>
          </nav>

          <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight drop-shadow-lg">
            Contáctanos
          </h1>

          <div class="w-24 h-2 bg-blue-600 mt-6 rounded-full shadow-lg"></div>

          <p class="text-gray-200 mt-6 text-lg md:text-xl max-w-2xl font-medium leading-relaxed drop-shadow-md">
            Estamos listos para asesorarte en tus proyectos de almacenamiento y mantenimiento industrial. Solicita una cotización hoy mismo.
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-[1200px] mx-auto px-5 py-16 md:py-24">
      <div class="flex flex-col md:flex-row gap-12 items-stretch">
          
          <div class="md:w-1/2 overflow-hidden rounded-2xl shadow-lg">

              <Image 
                    src={planta}
                    alt="Planta de operaciones R&A Racks en Callao, Lima"
                    class="w-full h-full object-cover transition-transform duration-700 hover:scale-110"
                    loading="lazy"/>

          </div>

          <div class="md:w-1/2 flex flex-col justify-center">
              <h2 class="text-3xl font-bold text-gray-900 mb-8 border-l-4 border-[#00388B] pl-4 italic">
                  Estamos listos para atenderte
              </h2>

              <div class="space-y-8">
                  <div>
                      <h3 class="text-[#00388B] text-sm font-bold uppercase tracking-widest mb-4">Canales Directos</h3>
                      <div class="space-y-4">
                          <a href="tel:+51923808882" class="flex items-center gap-4 group">
                              <div class="bg-blue-50 p-3 rounded-full group-hover:bg-blue-600 transition-colors">
                                  <img src={`${import.meta.env.BASE_URL}images/iconos/phone_b.svg`} alt="Teléfono" class="w-6 h-6 group-hover:invert transition-all"/>
                              </div>
                              <span class="text-lg md:text-xl font-medium text-gray-700 group-hover:text-blue-600">+51 923 808 882</span>
                          </a>
                          
                          <a href="mailto:hcavero@pyaracks.com" class="flex items-center gap-4 group">
                              <div class="bg-blue-50 p-3 rounded-full group-hover:bg-blue-600 transition-colors">
                                  <img src={`${import.meta.env.BASE_URL}images/iconos/mail_b.svg`} alt="Email" class="w-6 h-6 group-hover:invert transition-all"/>
                              </div>
                              <span class="text-lg md:text-xl font-medium text-gray-700 group-hover:text-blue-600 break-all">hcavero@pyaracks.com</span>
                          </a>
                      </div>
                  </div>

                  <div class="pt-6 border-t border-gray-100">
                      <h3 class="text-[#00388B] text-sm font-bold uppercase tracking-widest mb-4">Oficina Principal</h3>
                      <div class="flex items-start gap-4">
                          <div class="bg-blue-50 p-3 rounded-full flex-shrink-0">
                              <img src={`${import.meta.env.BASE_URL}images/iconos/location_b.svg`} alt="Ubicación" class="w-6 h-6"/>
                          </div>
                          <address class="not-italic text-gray-600 leading-relaxed text-sm md:text-base">
                              CAL. 4 MZA. E-5 LOTE 9 A.H. BOCANEGRA<br/>
                              PROV. CONST. DEL CALLAO - CALLAO, PERÚ
                          </address>
                      </div>
                  </div>
              </div>
          </div>
      </div>
    </section>

<div class="w-full h-[400px] md:h-[550px] bg-gray-200 grayscale hover:grayscale-0 transition-all duration-700">
    <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15609.610191834167!2d-77.108252!3d-12.01579!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105cb7999719391%3A0xc39527c328e3b070!2sBocanegra%2C%20Callao!5e0!3m2!1ses!2spe!4v1700000000000!5m2!1ses!2spe" 
        class="w-full h-full border-0" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
    </iframe>
</div>
  
  </main>
</MainLayout>