---
import { Image } from "astro:assets";
import persona from "../assets/images/inicio/persona.png";
import mantenimientoTecho from "../assets/images/inicio/mantenimiento-de-techo-7.jpeg";
import armadoMiniRacks from "../assets/images/inicio/armado-de-mini-racks-1.jpeg";


const projects = [
  {
    title: "Mantenimiento de Techo Industrial",
    location: "Chorrillos, Lima",
    slug: "mantenimiento-de-techos-industriales",
    image: mantenimientoTecho,
  },
  {
    title: "Instalación de Mini Racks",
    location: "Huachipa, Lima",
    slug: "instalación-y-armado-de-mini-racks",
    image: armadoMiniRacks,
  }
];
---

<section class="py-16 md:mt-[120px] px-4 flex justify-center bg-gray-50/50">
  <div class="w-full max-w-[1250px]">
    
    <div class="relative bg-[#00388B] rounded-2xl md:rounded-r-none py-8 md:py-16 px-8 md:px-12 mb-10 overflow-visible">
      <div class="max-w-2xl">
        <h3 class="text-white font-black text-4xl md:text-6xl uppercase tracking-tighter leading-none">
          Nuestros <br/> <span class="text-[#FFA100]">Proyectos</span>
        </h3>
        <p class="text-blue-100 mt-4 text-lg hidden md:block">
          Soluciones de ingeniería ejecutadas con los más altos estándares de seguridad y eficiencia en todo el Perú.
        </p>
      </div>

      <div class="hidden lg:block">

        <Image src={persona}
              alt="Ingeniero de P&A Racks supervisando proyecto"
              width={350} 
              height={525}
              class="h-[500px] w-[350px] object-cover object-top absolute right-10 bottom-0 pointer-events-none drop-shadow-2xl translate-y-[20%]"
              loading="eager"/>

      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <article class="group relative overflow-hidden rounded-2xl shadow-lg bg-white border border-gray-100">
          <a href={`/proyectos/${project.slug}`} class="block relative h-[350px] md:h-[450px]">

            <Image src={project.image}
                alt={`Proyecto de ${project.title} en ${project.location}`}
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-1100"
                loading="lazy"/>

            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10"></div>

            <div class="absolute bottom-0 left-0 p-8 z-20 w-full transition-transform duration-500 group-hover:-translate-y-2">
              <span class="inline-block bg-[#FFA100] text-[#001F4D] text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-widest">
                {project.location}
              </span>
              <h2 class="text-white text-2xl md:text-3xl font-extrabold leading-tight">
                {project.title}
              </h2>
              
              <div class="mt-4 flex items-center gap-2 text-blue-400 font-bold opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-4 group-hover:translate-y-0">
                <span>Ver detalles del proyecto</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="flex items-center justify-center mt-16">
      <a 
        href={`${import.meta.env.BASE_URL}proyectos`}
        class="group relative inline-flex items-center justify-center px-12 py-4 font-bold text-white transition-all duration-300 bg-[#00388B] rounded-lg hover:bg-blue-800 overflow-hidden shadow-xl"
      >
        <span class="relative z-10">Ver más proyectos</span>
        <div class="absolute inset-0 w-0 bg-[#FFA100] transition-all duration-300 group-hover:w-full opacity-10"></div>
      </a>
    </div>

  </div>
</section>